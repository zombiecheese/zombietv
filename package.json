{
  "name": "zombietv",
  "version": "1.0.0",
  "description": "1990s Australian Broadcast Simulator - Web-based TV broadcasting simulation",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:init": "node scripts/init-db.js",
    "db:migrate": "prisma migrate dev",
    "admin": "next dev -p 3001"
  },
  "dependencies": {
    "@prisma/client": "^5.7.0",
    "bcryptjs": "^2.4.3",
    "date-fns": "^3.0.0",
    "hls.js": "^1.6.16",
    "iron-session": "^8.0.1",
    "next": "^16.2.11",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.19.43",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "prisma": "^5.7.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "nanoid": "^3.3.18",
    "sharp": "^0.35.0"
  }
}
